      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Spline+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');\n  .dh-sans { font-family: 'Spline Sans', ui-sans-serif, system-ui, sans-serif; }\n  .dh-mono { font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace; }\n</style>\n<div class=\"dh-sans min-h-screen bg-[#0f0f17] p-3 text-[#1a1920] sm:p-5 lg:p-7\" data-kid=\"1\">\n    <main class=\"mx-auto max-w-[1240px] overflow-hidden rounded-[30px] bg-[#f1ebdd] shadow-[0_22px_70px_rgba(0,0,0,.28)]\" data-kid=\"1-1\">\n        <header class=\"border-b border-[#d8d0c2] px-5 pb-5 pt-5 sm:px-8 sm:pt-7\" data-kid=\"1-1-1\">\n            <div class=\"flex flex-col gap-6 xl:flex-row xl:items-end xl:justify-between\" data-kid=\"1-1-1-1\">\n                <div class=\"flex items-start gap-4\" data-kid=\"1-1-1-1-1\">\n                    <div class=\"mt-1 grid h-11 w-11 shrink-0 place-items-center rounded-[12px] bg-[#0f0f17] text-sm font-semibold tracking-[-0.04em] text-[#f1ebdd]\" data-kid=\"1-1-1-1-1-1\">\n                        DH\n                    </div>\n                    <div data-kid=\"1-1-1-1-1-2\">\n                        <div class=\"dh-mono mb-2 text-[10px] font-medium uppercase tracking-[0.2em] text-[#756f68]\" data-kid=\"1-1-1-1-1-2-1\">\n                            DIVINEHUB / API NOTEBOOK\n                        </div>\n                        <h1 class=\"text-[clamp(2rem,4vw,3.5rem)] font-semibold leading-[.98] tracking-[-0.06em] text-[#1a1920]\" data-kid=\"1-1-1-1-1-2-2\">\n                            Authentication\n                            <span class=\"font-normal italic text-[#6f60b8]\" data-kid=\"1-1-1-1-1-2-2-1\">\n                                contract\n                            </span>\n                        </h1>\n                        <p class=\"mt-3 max-w-[560px] text-sm leading-6 text-[#756f68]\" data-kid=\"1-1-1-1-1-2-3\">\n                            A compact source of truth for identity, JWT sessions, recovery, and the edges where authentication can safely stop.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-2 xl:justify-end\" data-kid=\"1-1-1-1-2\">\n                    <div class=\"dh-mono rounded-full border border-[#d8d0c2] bg-[#fbf7ef] px-3 py-2 text-[10px] uppercase tracking-[.14em] text-[#756f68]\" data-kid=\"1-1-1-1-2-1\">\n                        OPENAPI 3.1 · v1.0.0\n                    </div>\n                    <div class=\"flex items-center gap-2 rounded-full border border-[#b7c8b7] bg-[#edf4eb] px-3 py-2 text-[10px] font-medium uppercase tracking-[.13em] text-[#4f7359]\" data-kid=\"1-1-1-1-2-2\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#76947b]\" data-kid=\"1-1-1-1-2-2-1\">\n                        </span>\n                        MongoDB connected\n                    </div>\n                    <div class=\"flex items-center gap-2 rounded-full border border-[#c9c1e7] bg-[#eeeafa] px-3 py-2 text-[10px] font-medium uppercase tracking-[.13em] text-[#5e50a3]\" data-kid=\"1-1-1-1-2-3\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#6f60b8]\" data-kid=\"1-1-1-1-2-3-1\">\n                        </span>\n                        JWT\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-6 flex flex-col gap-2 border-l-2 border-[#6f60b8] pl-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-1-2\">\n                <div class=\"dh-mono text-[11px] text-[#756f68]\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"text-[#6f60b8]\" data-kid=\"1-1-1-2-1-1\">\n                        BASE\n                    </span>\n                    http://localhost:4000/api\n                </div>\n                <div class=\"dh-mono text-[10px] uppercase tracking-[.14em] text-[#756f68]\" data-kid=\"1-1-1-2-2\">\n                    source / docs/openapi.yaml · verified auth surface\n                </div>\n            </div>\n        </header>\n        <section class=\"px-5 py-6 sm:px-8 sm:py-8\" data-kid=\"1-1-2\">\n            <div class=\"mb-4 flex items-end justify-between gap-4\" data-kid=\"1-1-2-1\">\n                <div data-kid=\"1-1-2-1-1\">\n                    <div class=\"dh-mono mb-1 text-[10px] font-medium uppercase tracking-[.2em] text-[#6f60b8]\" data-kid=\"1-1-2-1-1-1\">\n                        01 // lifecycle gates\n                    </div>\n                    <h2 class=\"text-xl font-semibold tracking-[-.04em] text-[#1a1920]\" data-kid=\"1-1-2-1-1-2\">\n                        The session moves left to right.\n                    </h2>\n                </div>\n                <div class=\"hidden text-right sm:block\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"dh-mono text-[10px] uppercase tracking-[.16em] text-[#756f68]\" data-kid=\"1-1-2-1-2-1\">\n                        public intake → bearer state\n                    </div>\n                    <div class=\"mt-1 text-xs text-[#756f68]\" data-kid=\"1-1-2-1-2-2\">\n                        Five documented operations\n                    </div>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-1 gap-2 lg:grid-cols-[minmax(0,1fr)_28px_minmax(0,1fr)_28px_minmax(0,1fr)_28px_minmax(0,1fr)_28px_minmax(0,1fr)]\" data-kid=\"1-1-2-2\">\n                <article class=\"relative flex min-h-[218px] flex-col justify-between rounded-[18px] border border-[#d8d0c2] bg-[#fbf7ef] p-4 shadow-[0_6px_18px_rgba(67,53,39,.05)]\" data-kid=\"1-1-2-2-1\">\n                    <div data-kid=\"1-1-2-2-1-1\">\n                        <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-1-2-2-1-1-1\">\n                            <span class=\"dh-mono grid h-7 w-7 place-items-center rounded-[8px] bg-[#eeeafa] text-[11px] font-semibold text-[#6f60b8]\" data-kid=\"1-1-2-2-1-1-1-1\">\n                                01\n                            </span>\n                            <span class=\"dh-mono text-[9px] uppercase tracking-[.16em] text-[#6f60b8]\" data-kid=\"1-1-2-2-1-1-1-2\">\n                                PUBLIC\n                            </span>\n                        </div>\n                        <h3 class=\"text-[15px] font-semibold tracking-[.12em] text-[#1a1920]\" data-kid=\"1-1-2-2-1-1-2\">\n                            REGISTER\n                        </h3>\n                        <div class=\"dh-mono mt-3 text-[11px] text-[#6f60b8]\" data-kid=\"1-1-2-2-1-1-3\">\n                            POST\n                            <span class=\"text-[#1a1920]\" data-kid=\"1-1-2-2-1-1-3-1\">\n                                /auth/register\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-xs leading-5 text-[#756f68]\" data-kid=\"1-1-2-2-1-1-4\">\n                            Create identity, hash password, issue the first token.\n                        </p>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-t border-[#e3ddd2] pt-3\" data-kid=\"1-1-2-2-1-2\">\n                        <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-2-2-1-2-1\">\n                            201 CREATED\n                        </span>\n                        <span class=\"text-xs font-medium text-[#6f60b8]\" data-kid=\"1-1-2-2-1-2-2\">\n                            token issued\n                        </span>\n                    </div>\n                </article>\n                <div class=\"hidden items-center justify-center lg:flex\" data-kid=\"1-1-2-2-2\">\n                    <div class=\"dh-mono text-lg text-[#6f60b8]\" data-kid=\"1-1-2-2-2-1\">\n                        ]›[\n                    </div>\n                </div>\n                <article class=\"relative flex min-h-[218px] flex-col justify-between rounded-[18px] border border-[#d8d0c2] bg-[#fbf7ef] p-4 shadow-[0_6px_18px_rgba(67,53,39,.05)]\" data-kid=\"1-1-2-2-3\">\n                    <div data-kid=\"1-1-2-2-3-1\">\n                        <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-1-2-2-3-1-1\">\n                            <span class=\"dh-mono grid h-7 w-7 place-items-center rounded-[8px] bg-[#eeeafa] text-[11px] font-semibold text-[#6f60b8]\" data-kid=\"1-1-2-2-3-1-1-1\">\n                                02\n                            </span>\n                            <span class=\"dh-mono text-[9px] uppercase tracking-[.16em] text-[#6f60b8]\" data-kid=\"1-1-2-2-3-1-1-2\">\n                                PUBLIC\n                            </span>\n                        </div>\n                        <h3 class=\"text-[15px] font-semibold tracking-[.12em] text-[#1a1920]\" data-kid=\"1-1-2-2-3-1-2\">\n                            LOGIN\n                        </h3>\n                        <div class=\"dh-mono mt-3 text-[11px] text-[#6f60b8]\" data-kid=\"1-1-2-2-3-1-3\">\n                            POST\n                            <span class=\"text-[#1a1920]\" data-kid=\"1-1-2-2-3-1-3-1\">\n                                /auth/login\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-xs leading-5 text-[#756f68]\" data-kid=\"1-1-2-2-3-1-4\">\n                            Accept email or username, compare password, return JWT.\n                        </p>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-t border-[#e3ddd2] pt-3\" data-kid=\"1-1-2-2-3-2\">\n                        <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-2-2-3-2-1\">\n                            200 OK\n                        </span>\n                        <span class=\"text-xs font-medium text-[#6f60b8]\" data-kid=\"1-1-2-2-3-2-2\">\n                            bearer state\n                        </span>\n                    </div>\n                </article>\n                <div class=\"hidden items-center justify-center lg:flex\" data-kid=\"1-1-2-2-4\">\n                    <div class=\"dh-mono text-lg text-[#6f60b8]\" data-kid=\"1-1-2-2-4-1\">\n                        ]›[\n                    </div>\n                </div>\n                <article class=\"relative flex min-h-[218px] flex-col justify-between rounded-[18px] border-2 border-[#6f60b8] bg-[#f7f3e9] p-4 shadow-[0_8px_22px_rgba(111,96,184,.12)]\" data-kid=\"1-1-2-2-5\">\n                    <div data-kid=\"1-1-2-2-5-1\">\n                        <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-1-2-2-5-1-1\">\n                            <span class=\"dh-mono grid h-7 w-7 place-items-center rounded-[8px] bg-[#6f60b8] text-[11px] font-semibold text-white\" data-kid=\"1-1-2-2-5-1-1-1\">\n                                03\n                            </span>\n                            <span class=\"dh-mono text-[9px] uppercase tracking-[.16em] text-[#6f60b8]\" data-kid=\"1-1-2-2-5-1-1-2\">\n                                BEARER\n                            </span>\n                        </div>\n                        <h3 class=\"text-[15px] font-semibold tracking-[.12em] text-[#1a1920]\" data-kid=\"1-1-2-2-5-1-2\">\n                            RESTORE\n                        </h3>\n                        <div class=\"dh-mono mt-3 text-[11px] text-[#6f60b8]\" data-kid=\"1-1-2-2-5-1-3\">\n                            GET\n                            <span class=\"text-[#1a1920]\" data-kid=\"1-1-2-2-5-1-3-1\">\n                                /auth/me\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-xs leading-5 text-[#756f68]\" data-kid=\"1-1-2-2-5-1-4\">\n                            Resolve the stored token back to the current user.\n                        </p>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-t border-[#d6d0ed] pt-3\" data-kid=\"1-1-2-2-5-2\">\n                        <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-2-2-5-2-1\">\n                            200 OK\n                        </span>\n                        <span class=\"text-xs font-medium text-[#6f60b8]\" data-kid=\"1-1-2-2-5-2-2\">\n                            session restored\n                        </span>\n                    </div>\n                </article>\n                <div class=\"hidden items-center justify-center lg:flex\" data-kid=\"1-1-2-2-6\">\n                    <div class=\"dh-mono text-lg text-[#6f60b8]\" data-kid=\"1-1-2-2-6-1\">\n                        ]›[\n                    </div>\n                </div>\n                <article class=\"relative flex min-h-[218px] flex-col justify-between rounded-[18px] border border-[#d8d0c2] bg-[#fbf7ef] p-4 shadow-[0_6px_18px_rgba(67,53,39,.05)]\" data-kid=\"1-1-2-2-7\">\n                    <div data-kid=\"1-1-2-2-7-1\">\n                        <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-1-2-2-7-1-1\">\n                            <span class=\"dh-mono grid h-7 w-7 place-items-center rounded-[8px] bg-[#eeeafa] text-[11px] font-semibold text-[#6f60b8]\" data-kid=\"1-1-2-2-7-1-1-1\">\n                                04\n                            </span>\n                            <span class=\"dh-mono text-[9px] uppercase tracking-[.16em] text-[#756f68]\" data-kid=\"1-1-2-2-7-1-1-2\">\n                                BEARER\n                            </span>\n                        </div>\n                        <h3 class=\"text-[15px] font-semibold tracking-[.12em] text-[#1a1920]\" data-kid=\"1-1-2-2-7-1-2\">\n                            CHANGE\n                        </h3>\n                        <div class=\"dh-mono mt-3 text-[11px] text-[#6f60b8]\" data-kid=\"1-1-2-2-7-1-3\">\n                            PUT\n                            <span class=\"text-[#1a1920]\" data-kid=\"1-1-2-2-7-1-3-1\">\n                                /auth/password\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-xs leading-5 text-[#756f68]\" data-kid=\"1-1-2-2-7-1-4\">\n                            Verify current secret before saving a new one.\n                        </p>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-t border-[#e3ddd2] pt-3\" data-kid=\"1-1-2-2-7-2\">\n                        <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-2-2-7-2-1\">\n                            200 OK\n                        </span>\n                        <span class=\"text-xs font-medium text-[#6f60b8]\" data-kid=\"1-1-2-2-7-2-2\">\n                            secret rotated\n                        </span>\n                    </div>\n                </article>\n                <div class=\"hidden items-center justify-center lg:flex\" data-kid=\"1-1-2-2-8\">\n                    <div class=\"dh-mono text-lg text-[#6f60b8]\" data-kid=\"1-1-2-2-8-1\">\n                        ]›[\n                    </div>\n                </div>\n                <article class=\"relative flex min-h-[218px] flex-col justify-between rounded-[18px] border border-[#d8d0c2] bg-[#fbf7ef] p-4 shadow-[0_6px_18px_rgba(67,53,39,.05)]\" data-kid=\"1-1-2-2-9\">\n                    <div data-kid=\"1-1-2-2-9-1\">\n                        <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-1-2-2-9-1-1\">\n                            <span class=\"dh-mono grid h-7 w-7 place-items-center rounded-[8px] bg-[#eeeafa] text-[11px] font-semibold text-[#6f60b8]\" data-kid=\"1-1-2-2-9-1-1-1\">\n                                05\n                            </span>\n                            <span class=\"dh-mono text-[9px] uppercase tracking-[.16em] text-[#756f68]\" data-kid=\"1-1-2-2-9-1-1-2\">\n                                BEARER\n                            </span>\n                        </div>\n                        <h3 class=\"text-[15px] font-semibold tracking-[.12em] text-[#1a1920]\" data-kid=\"1-1-2-2-9-1-2\">\n                            LOGOUT\n                        </h3>\n                        <div class=\"dh-mono mt-3 text-[11px] text-[#6f60b8]\" data-kid=\"1-1-2-2-9-1-3\">\n                            POST\n                            <span class=\"text-[#1a1920]\" data-kid=\"1-1-2-2-9-1-3-1\">\n                                /auth/logout\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-xs leading-5 text-[#756f68]\" data-kid=\"1-1-2-2-9-1-4\">\n                            Accept the bearer request; client removes its local token.\n                        </p>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-t border-[#e3ddd2] pt-3\" data-kid=\"1-1-2-2-9-2\">\n                        <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-2-2-9-2-1\">\n                            204 NO BODY\n                        </span>\n                        <span class=\"text-xs font-medium text-[#6f60b8]\" data-kid=\"1-1-2-2-9-2-2\">\n                            session ended\n                        </span>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section class=\"grid gap-4 border-t border-[#d8d0c2] px-5 py-6 sm:px-8 sm:py-8 lg:grid-cols-[minmax(0,1.45fr)_minmax(280px,.55fr)]\" data-kid=\"1-1-3\">\n            <div class=\"rounded-[20px] border border-[#d8d0c2] bg-[#fbf7ef] p-5 sm:p-6\" data-kid=\"1-1-3-1\">\n                <div class=\"mb-5 flex flex-wrap items-end justify-between gap-3\" data-kid=\"1-1-3-1-1\">\n                    <div data-kid=\"1-1-3-1-1-1\">\n                        <div class=\"dh-mono mb-1 text-[10px] font-medium uppercase tracking-[.2em] text-[#6f60b8]\" data-kid=\"1-1-3-1-1-1-1\">\n                            02 // payload shapes\n                        </div>\n                        <h2 class=\"text-xl font-semibold tracking-[-.04em]\" data-kid=\"1-1-3-1-1-1-2\">\n                            Inputs are explicit. Secrets stay quiet.\n                        </h2>\n                    </div>\n                    <span class=\"dh-mono rounded-full bg-[#eeeafa] px-3 py-1.5 text-[10px] uppercase tracking-[.13em] text-[#6f60b8]\" data-kid=\"1-1-3-1-1-2\">\n                        application/json\n                    </span>\n                </div>\n                <div class=\"grid gap-3 md:grid-cols-3\" data-kid=\"1-1-3-1-2\">\n                    <div class=\"rounded-[14px] border border-[#e0d9ce] bg-[#f5f0e6] p-4\" data-kid=\"1-1-3-1-2-1\">\n                        <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-1-3-1-2-1-1\">\n                            <span class=\"dh-mono text-[10px] text-[#6f60b8]\" data-kid=\"1-1-3-1-2-1-1-1\">\n                                REGISTER\n                            </span>\n                            <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-3-1-2-1-1-2\">\n                                required × 5\n                            </span>\n                        </div>\n                        <div class=\"space-y-2 text-xs\" data-kid=\"1-1-3-1-2-1-2\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-1-2-1\">\n                                <span data-kid=\"1-1-3-1-2-1-2-1-1\">\n                                    fullName\n                                </span>\n                                <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-3-1-2-1-2-1-2\">\n                                    string\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-1-2-2\">\n                                <span data-kid=\"1-1-3-1-2-1-2-2-1\">\n                                    username\n                                </span>\n                                <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-3-1-2-1-2-2-2\">\n                                    3–24 chars\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-1-2-3\">\n                                <span data-kid=\"1-1-3-1-2-1-2-3-1\">\n                                    email\n                                </span>\n                                <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-3-1-2-1-2-3-2\">\n                                    email\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-1-2-4\">\n                                <span data-kid=\"1-1-3-1-2-1-2-4-1\">\n                                    phoneNumber\n                                </span>\n                                <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-3-1-2-1-2-4-2\">\n                                    string\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-1-2-5\">\n                                <span data-kid=\"1-1-3-1-2-1-2-5-1\">\n                                    password\n                                </span>\n                                <span class=\"dh-mono text-[10px] tracking-[.12em] text-[#756f68]\" data-kid=\"1-1-3-1-2-1-2-5-2\">\n                                    ••••••••\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"rounded-[14px] border border-[#e0d9ce] bg-[#f5f0e6] p-4\" data-kid=\"1-1-3-1-2-2\">\n                        <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-1-3-1-2-2-1\">\n                            <span class=\"dh-mono text-[10px] text-[#6f60b8]\" data-kid=\"1-1-3-1-2-2-1-1\">\n                                LOGIN\n                            </span>\n                            <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-3-1-2-2-1-2\">\n                                required × 2\n                            </span>\n                        </div>\n                        <div class=\"space-y-2 text-xs\" data-kid=\"1-1-3-1-2-2-2\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-2-2-1\">\n                                <span data-kid=\"1-1-3-1-2-2-2-1-1\">\n                                    identifier\n                                </span>\n                                <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-3-1-2-2-2-1-2\">\n                                    email | user\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-2-2-2\">\n                                <span data-kid=\"1-1-3-1-2-2-2-2-1\">\n                                    password\n                                </span>\n                                <span class=\"dh-mono text-[10px] tracking-[.12em] text-[#756f68]\" data-kid=\"1-1-3-1-2-2-2-2-2\">\n                                    ••••••••\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"mt-5 border-t border-[#e0d9ce] pt-3 dh-mono text-[10px] leading-5 text-[#756f68]\" data-kid=\"1-1-3-1-2-2-3\">\n                            email or username accepted\n                        </div>\n                    </div>\n                    <div class=\"rounded-[14px] border border-[#e0d9ce] bg-[#f5f0e6] p-4\" data-kid=\"1-1-3-1-2-3\">\n                        <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-1-3-1-2-3-1\">\n                            <span class=\"dh-mono text-[10px] text-[#6f60b8]\" data-kid=\"1-1-3-1-2-3-1-1\">\n                                PASSWORD\n                            </span>\n                            <span class=\"dh-mono text-[10px] text-[#756f68]\" data-kid=\"1-1-3-1-2-3-1-2\">\n                                authenticated\n                            </span>\n                        </div>\n                        <div class=\"space-y-2 text-xs\" data-kid=\"1-1-3-1-2-3-2\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-3-2-1\">\n                                <span data-kid=\"1-1-3-1-2-3-2-1-1\">\n                                    currentPassword\n                                </span>\n                                <span class=\"dh-mono text-[10px] tracking-[.12em] text-[#756f68]\" data-kid=\"1-1-3-1-2-3-2-1-2\">\n                                    ••••••••\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-3-1-2-3-2-2\">\n                                <span data-kid=\"1-1-3-1-2-3-2-2-1\">\n                                    newPassword\n                                </span>\n                                <span class=\"dh-mono text-[10px] tracking-[.12em] text-[#756f68]\" data-kid=\"1-1-3-1-2-3-2-2-2\">\n                                    ••••••••\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"mt-5 border-t border-[#e0d9ce] pt-3 dh-mono text-[10px] leading-5 text-[#756f68]\" data-kid=\"1-1-3-1-2-3-3\">\n                            minimum 8 characters\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-4 flex flex-col gap-3 rounded-[14px] border border-[#d8d0c2] bg-[#f1ebdd] p-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-3-1-3\">\n                    <div data-kid=\"1-1-3-1-3-1\">\n                        <div class=\"dh-mono text-[10px] uppercase tracking-[.16em] text-[#756f68]\" data-kid=\"1-1-3-1-3-1-1\">\n                            success envelope\n                        </div>\n                        <div class=\"mt-1 text-sm font-medium\" data-kid=\"1-1-3-1-3-1-2\">\n                            { success: true, data: { user, token } }\n                        </div>\n                    </div>\n                    <div class=\"dh-mono text-[10px] text-[#6f60b8]\" data-kid=\"1-1-3-1-3-2\">\n                        register 201 · login 200\n                    </div>\n                </div>\n            </div>\n            <aside class=\"relative overflow-hidden rounded-[20px] bg-[#6f60b8] p-5 text-[#f7f3e9] sm:p-6\" data-kid=\"1-1-3-2\">\n                <div class=\"absolute bottom-0 right-5 top-0 w-px bg-[#c9c1e7]/40\" data-kid=\"1-1-3-2-1\">\n                </div>\n                <div class=\"absolute bottom-8 right-[13px] h-3 w-3 rounded-full border-2 border-[#f7f3e9] bg-[#6f60b8]\" data-kid=\"1-1-3-2-2\">\n                </div>\n                <div class=\"relative pr-8\" data-kid=\"1-1-3-2-3\">\n                    <div class=\"dh-mono mb-8 text-[10px] uppercase tracking-[.2em] text-[#e1ddf4]\" data-kid=\"1-1-3-2-3-1\">\n                        SESSION SPINE\n                    </div>\n                    <div class=\"dh-mono text-[10px] uppercase tracking-[.14em] text-[#d6d0ed]\" data-kid=\"1-1-3-2-3-2\">\n                        authorization\n                    </div>\n                    <div class=\"mt-2 break-words text-sm font-medium leading-6\" data-kid=\"1-1-3-2-3-3\">\n                        Authorization: Bearer\n                        <br data-kid=\"1-1-3-2-3-3-1\"/>\n                        <span class=\"text-[#e1ddf4]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-3-2\" data-name=\"access token placeholder\" data-reason=\"replaced by actual token from application state\">\n                            <access-token>\n                        </span>\n                    </div>\n                    <div class=\"my-7 h-px bg-[#c9c1e7]/40\" data-kid=\"1-1-3-2-3-4\">\n                    </div>\n                    <div class=\"dh-mono text-[10px] uppercase tracking-[.14em] text-[#d6d0ed]\" data-kid=\"1-1-3-2-3-5\">\n                        issued by\n                    </div>\n                    <div class=\"mt-2 text-sm leading-6\" data-kid=\"1-1-3-2-3-6\">\n                        JWT returned from\n                        <br data-kid=\"1-1-3-2-3-6-1\"/>\n                        <span class=\"font-semibold\" data-kid=\"1-1-3-2-3-6-2\">\n                            register\n                        </span>\n                        and\n                        <span class=\"font-semibold\" data-kid=\"1-1-3-2-3-6-3\">\n                            login\n                        </span>\n                        .\n                    </div>\n                    <div class=\"my-7 h-px bg-[#c9c1e7]/40\" data-kid=\"1-1-3-2-3-7\">\n                    </div>\n                    <div class=\"dh-mono text-[10px] uppercase tracking-[.14em] text-[#d6d0ed]\" data-kid=\"1-1-3-2-3-8\">\n                        client memory\n                    </div>\n                    <div class=\"mt-2 dh-mono text-[11px] leading-6 text-[#f7f3e9]\" data-kid=\"1-1-3-2-3-9\">\n                        localStorage\n                        <br data-kid=\"1-1-3-2-3-9-1\"/>\n                        <span class=\"text-[#e1ddf4]\" data-kid=\"1-1-3-2-3-9-2\">\n                            divinehub.accessToken\n                        </span>\n                    </div>\n                    <div class=\"mt-6 rounded-[12px] border border-[#c9c1e7]/50 bg-[#5e50a3] p-3 text-xs leading-5 text-[#f7f3e9]\" data-kid=\"1-1-3-2-3-10\">\n                        Axios attaches the bearer token. A 401 clears the session and routes back to login.\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <section class=\"border-t border-[#d8d0c2] px-5 py-6 sm:px-8 sm:py-8\" data-kid=\"1-1-4\">\n            <div class=\"mb-4 flex flex-wrap items-end justify-between gap-3\" data-kid=\"1-1-4-1\">\n                <div data-kid=\"1-1-4-1-1\">\n                    <div class=\"dh-mono mb-1 text-[10px] font-medium uppercase tracking-[.2em] text-[#6f60b8]\" data-kid=\"1-1-4-1-1-1\">\n                        03 // boundary behavior\n                    </div>\n                    <h2 class=\"text-xl font-semibold tracking-[-.04em]\" data-kid=\"1-1-4-1-1-2\">\n                        When the contract refuses the request.\n                    </h2>\n                </div>\n                <div class=\"dh-mono text-[10px] uppercase tracking-[.14em] text-[#756f68]\" data-kid=\"1-1-4-1-2\">\n                    errors are structured, not mysterious\n                </div>\n            </div>\n            <div class=\"grid gap-2 sm:grid-cols-2 lg:grid-cols-5\" data-kid=\"1-1-4-2\">\n                <div class=\"rounded-[14px] border border-[#e5c5c8] bg-[#fcf2f0] p-4\" data-kid=\"1-1-4-2-1\">\n                    <div class=\"dh-mono text-lg font-semibold text-[#b85665]\" data-kid=\"1-1-4-2-1-1\">\n                        400\n                    </div>\n                    <div class=\"mt-2 text-xs font-medium\" data-kid=\"1-1-4-2-1-2\">\n                        VALIDATION_ERROR\n                    </div>\n                    <div class=\"mt-2 text-[11px] leading-5 text-[#756f68]\" data-kid=\"1-1-4-2-1-3\">\n                        fieldErrors point back to the payload.\n                    </div>\n                </div>\n                <div class=\"rounded-[14px] border border-[#e5c5c8] bg-[#fcf2f0] p-4\" data-kid=\"1-1-4-2-2\">\n                    <div class=\"dh-mono text-lg font-semibold text-[#b85665]\" data-kid=\"1-1-4-2-2-1\">\n                        401\n                    </div>\n                    <div class=\"mt-2 text-xs font-medium leading-5\" data-kid=\"1-1-4-2-2-2\">\n                        INVALID_CREDENTIALS\n                        <br data-kid=\"1-1-4-2-2-2-1\"/>\n                        INVALID_TOKEN · UNAUTHORIZED\n                    </div>\n                    <div class=\"mt-2 text-[11px] leading-5 text-[#756f68]\" data-kid=\"1-1-4-2-2-3\">\n                        clear the local session when needed.\n                    </div>\n                </div>\n                <div class=\"rounded-[14px] border border-[#e7d6bc] bg-[#fff7eb] p-4\" data-kid=\"1-1-4-2-3\">\n                    <div class=\"dh-mono text-lg font-semibold text-[#bc824b]\" data-kid=\"1-1-4-2-3-1\">\n                        409\n                    </div>\n                    <div class=\"mt-2 text-xs font-medium leading-5\" data-kid=\"1-1-4-2-3-2\">\n                        EMAIL_EXISTS\n                        <br data-kid=\"1-1-4-2-3-2-1\"/>\n                        USERNAME_EXISTS\n                    </div>\n                    <div class=\"mt-2 text-[11px] leading-5 text-[#756f68]\" data-kid=\"1-1-4-2-3-3\">\n                        identity collision, no partial user.\n                    </div>\n                </div>\n                <div class=\"rounded-[14px] border border-[#e7d6bc] bg-[#fff7eb] p-4\" data-kid=\"1-1-4-2-4\">\n                    <div class=\"dh-mono text-lg font-semibold text-[#bc824b]\" data-kid=\"1-1-4-2-4-1\">\n                        429\n                    </div>\n                    <div class=\"mt-2 text-xs font-medium\" data-kid=\"1-1-4-2-4-2\">\n                        RATE_LIMITED\n                    </div>\n                    <div class=\"mt-2 text-[11px] leading-5 text-[#756f68]\" data-kid=\"1-1-4-2-4-3\">\n                        slow down and try again later.\n                    </div>\n                </div>\n                <div class=\"rounded-[14px] border border-[#d8d0c2] bg-[#fbf7ef] p-4\" data-kid=\"1-1-4-2-5\">\n                    <div class=\"dh-mono text-lg font-semibold text-[#756f68]\" data-kid=\"1-1-4-2-5-1\">\n                        503\n                    </div>\n                    <div class=\"mt-2 text-xs font-medium\" data-kid=\"1-1-4-2-5-2\">\n                        DATABASE_UNAVAILABLE\n                    </div>\n                    <div class=\"mt-2 text-[11px] leading-5 text-[#756f68]\" data-kid=\"1-1-4-2-5-3\">\n                        start MongoDB or check MONGODB_URI.\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-5 mb-6 rounded-[18px] border-l-4 border-[#b85665] bg-[#fbf1ed] px-5 py-4 sm:mx-8 sm:px-6\" data-kid=\"1-1-5\">\n            <div class=\"flex flex-col gap-3 md:flex-row md:items-center md:justify-between\" data-kid=\"1-1-5-1\">\n                <div data-kid=\"1-1-5-1-1\">\n                    <div class=\"dh-mono mb-1 text-[10px] font-medium uppercase tracking-[.2em] text-[#b85665]\" data-kid=\"1-1-5-1-1-1\">\n                        04 // destructive edge\n                    </div>\n                    <h2 class=\"text-base font-semibold tracking-[-.02em]\" data-kid=\"1-1-5-1-1-2\">\n                        Account cleanup is deliberate.\n                    </h2>\n                    <p class=\"mt-1 max-w-[720px] text-xs leading-5 text-[#756f68]\" data-kid=\"1-1-5-1-1-3\">\n                        Authenticated\n                        <span class=\"dh-mono text-[11px] text-[#b85665]\" data-kid=\"1-1-5-1-1-3-1\">\n                            DELETE /users/account\n                        </span>\n                        requires the current username for confirmation, returns\n                        <span class=\"dh-mono text-[11px] text-[#b85665]\" data-kid=\"1-1-5-1-1-3-2\">\n                            204\n                        </span>\n                        , and removes account-owned posts, comments, saves, messages, conversations, notifications, and follow references.\n                    </p>\n                </div>\n                <div class=\"dh-mono shrink-0 rounded-[10px] border border-[#e5c5c8] bg-[#fff8f4] px-3 py-2 text-[10px] uppercase tracking-[.12em] text-[#b85665]\" data-kid=\"1-1-5-1-2\">\n                    confirmation required\n                </div>\n            </div>\n        </section>\n        <footer class=\"flex flex-col gap-3 border-t border-[#d8d0c2] px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-8\" data-kid=\"1-1-6\">\n            <div class=\"dh-mono text-[10px] leading-5 text-[#756f68]\" data-kid=\"1-1-6-1\">\n                AUTH ROUTES · 60 REQUESTS / 15 MINUTES\n            </div>\n            <div class=\"dh-mono text-[10px] leading-5 text-[#756f68]\" data-kid=\"1-1-6-2\">\n                { success, data?, message?, code?, fieldErrors? }\n            </div>\n            <div class=\"text-[10px] font-medium uppercase tracking-[.14em] text-[#6f60b8]\" data-kid=\"1-1-6-3\">\n                the contract is the courtyard\n            </div>\n        </footer>\n    </main>\n</div>\n",
